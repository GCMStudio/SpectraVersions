{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SpectraVersions registry",
    "type": "object",
    "required": ["latest", "versions"],
    "properties": {
        "$schema": { "type": "string" },
        "latest": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "versions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "additionalProperties": { "$ref": "#/definitions/release" }
        }
    },
    "definitions": {
        "release": {
            "type": "object",
            "required": ["minimumVersion", "build", "releaseDate", "severity", "changelog", "sha256", "downloadUrl"],
            "properties": {
                "minimumVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
                "build": { "type": "integer", "minimum": 1 },
                "releaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "severity": { "enum": ["none", "recommended", "required", "critical"] },
                "changelog": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
            },
            "additionalProperties": true
        }
    }
}
